# Copy to .env.local and fill in. Never commit .env.local. Prod values live in the Vercel dashboard.
# The build and the tests run without these values.

DATABASE_URL=                 # Neon pooled connection string (-pooler). Used by the app at runtime.
DATABASE_URL_UNPOOLED=        # Neon direct connection string. Used by drizzle-kit migrate only.
NEON_AUTH_BASE_URL=           # From the Neon console: Auth, Configuration.
NEON_AUTH_COOKIE_SECRET=      # 32 characters or more. Example: openssl rand -base64 32
AGENT_URL=                    # Base URL of the agent service, for example http://localhost:8000
INTERNAL_TOKEN=               # Same value as the agent service. Server-side only.
NEXT_PUBLIC_APP_URL=          # Public URL of this app, for example http://localhost:3000
TEAM_EMAILS=                  # Comma-separated emails that may open /demo
NEXT_PUBLIC_AUTH_GOOGLE=      # Set to 1 to show Google sign-in. Enable the Google provider in Neon Auth first.
