// Public landing page and sign-in (no auth). Smoke test for the testreel pipeline.
{
  "$schema": "../node_modules/testreel/recording-definition.schema.json",
  "url": "${PULSE_URL}",
  "viewport": { "width": 1440, "height": 900 },
  "outputSize": { "width": 1920, "height": 1080 },
  "colorScheme": "dark",
  "outputFormat": "mp4",
  "cursor": { "style": "pointer" },
  "chrome": { "url": "pulse-mhacks.vercel.app" },
  "background": { "gradient": { "from": "#1f1a17", "to": "#3a2a20" }, "padding": 64, "borderRadius": 14 },
  "steps": [
    { "action": "wait", "ms": 1200 },
    { "action": "scroll", "y": 500, "pauseAfter": 900 },
    { "action": "scroll", "y": -500, "pauseAfter": 600 },
    { "action": "navigate", "url": "${PULSE_URL}/auth/sign-in", "pauseAfter": 1200 },
    { "action": "screenshot", "name": "sign-in" }
  ]
}
