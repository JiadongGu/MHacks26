// Signed-in dashboard tour. Needs video/.auth/state.json (see the testreel skill).
{
  "$schema": "../node_modules/testreel/recording-definition.schema.json",
  "url": "${PULSE_URL}/dashboard",
  "storageState": "./video/.auth/state.json",
  "viewport": { "width": 1440, "height": 900 },
  "outputSize": { "width": 1920, "height": 1080 },
  "colorScheme": "dark",
  "outputFormat": "mp4",
  "waitForSelector": "text=Heart rate",
  "cursor": { "style": "pointer" },
  "chrome": { "url": "pulse-mhacks.vercel.app/dashboard" },
  "background": { "gradient": { "from": "#1f1a17", "to": "#3a2a20" }, "padding": 64, "borderRadius": 14 },
  "steps": [
    { "action": "wait", "ms": 1500 },
    { "action": "zoom", "selector": "text=Twin status", "scale": 1.6, "pauseAfter": 1500 },
    { "action": "zoom", "scale": 1 },
    { "action": "click", "selector": "role=button[name='Play the morning briefing']", "pauseAfter": 4000 },
    { "action": "scroll", "y": 700, "pauseAfter": 1500 },
    { "action": "zoom", "selector": "text=Heart rate", "scale": 1.5, "pauseAfter": 2000 },
    { "action": "zoom", "scale": 1 },
    { "action": "scroll", "y": 700, "pauseAfter": 1500 },
    { "action": "screenshot", "name": "dashboard-alerts" }
  ]
}
