# Copy per service to .env and fill in. Never commit .env. Prod values live in Vercel/Railway dashboards.

# ---- services/agent ----
DATABASE_URL=                 # Neon pooled connection string (-pooler)
SPACETIME_HOST=https://maincloud.spacetimedb.com
SPACETIME_DB=pulse-live-t8ng8
SPACETIME_ADMIN_VIEWS=       # 1 when SPACETIME_TOKEN is an admin, not the owner: read admin_* views
SPACETIME_TOKEN=              # owner token (spacetime login); server-side only
INTERNAL_TOKEN=               # shared secret for web/gateway/fetchai -> agent calls
GATEWAY_URL=                  # http://gateway:8789 on Railway
GATEWAY_SECRET=               # auth for agent -> gateway /send
SECRET_KEY=                   # Fernet key for encrypting OAuth tokens
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_SMART=gemini-3.8-flash
LLM_FAKE=0                    # 1 = deterministic templates (CI, fallback)
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_SUBSCRIBER_VERIFY_CODE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=          # https://<agent>/integrations/google/callback
FINCHNODE_API_KEY=            # optional; demo API needs none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AGENT_SEED=                   # stable seed so the Fetch.ai agent address never changes
PUBLIC_WEB_URL=
PUBLIC_AGENT_URL=
PHOTON_NUMBER_DISPLAY=        # number shown in onboarding step 6

# ---- services/gateway ----
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
AGENT_URL=
# INTERNAL_TOKEN, GATEWAY_SECRET as above
PORT=8789

# ---- apps/web ----
# DATABASE_URL as above
DATABASE_URL_UNPOOLED=        # for drizzle-kit migrate
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# AGENT_URL, INTERNAL_TOKEN as above
NEXT_PUBLIC_APP_URL=
TEAM_EMAILS=                  # comma-separated; gates /demo
