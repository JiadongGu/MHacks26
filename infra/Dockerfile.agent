# Build from the repo root: docker build -f infra/Dockerfile.agent .
# One image, two services. SERVICE=api (default) runs the FastAPI agent; SERVICE=fetchai runs the uAgent.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
RUN pip install --no-cache-dir uv==0.12.22

# finchnode.load_fixture() resolves contracts/fixtures four levels above app/twin, so keep this layout.
WORKDIR /repo/services/agent
COPY services/agent/pyproject.toml services/agent/uv.lock ./
RUN uv sync --frozen --no-dev
COPY services/agent/app ./app
COPY contracts/fixtures /repo/contracts/fixtures
COPY infra/entrypoint.sh /entrypoint.sh

ENV PATH="/repo/services/agent/.venv/bin:$PATH"
RUN chmod +x /entrypoint.sh && useradd --system --uid 10001 pulse && chown -R pulse /repo
USER pulse
EXPOSE 8000
CMD ["/entrypoint.sh"]
